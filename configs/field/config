[reticulum]
  enable_transport = No
  share_instance = No
  discover_interfaces = Yes
  autoconnect_discovered_interfaces = 3
  required_discovery_value = 16

[logging]
  loglevel = 4

[interfaces]
  [[Reticom Local TCP Client]]
    type = TCPClientInterface
    enabled = Yes
    target_host = 127.0.0.1
    target_port = 4242

